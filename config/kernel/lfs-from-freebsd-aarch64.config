# Kernel config fragment — aarch64 (LF_ARCH=aarch64)
# Copyright (c) 2026 REVYTECH, Inc.
#
# Applied ONLY after amd64 Milestone C is green — see docs/MULTI-ARCH.md.
# Start from ARCH=arm64 defconfig + this fragment (same apply-kernel-config flow).
#
# Delta vs amd64: no legacy BIOS; UEFI + virtio + (where available) VMware
# Fusion arm64 paths. open-vm-tools remains userspace (chapter 1450).

# --- BOOT (UEFI only on aarch64) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- VIRT (bhyve-on-aarch64 hosts + VMware Fusion arm64) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_ACPI=y

# --- DESKTOP ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_FUSE_FS=y

# Same FreeBSD-hostile host-tool disables as amd64 fragment
CONFIG_SECURITY_SELINUX=n
CONFIG_OBJTOOL=n
CONFIG_STACK_VALIDATION=n
CONFIG_MODULE_SIG=n
CONFIG_IMA=n
CONFIG_INTEGRITY=n
