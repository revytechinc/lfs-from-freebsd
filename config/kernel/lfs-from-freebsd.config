# Kernel config fragment for lfs-from-freebsd
# Copyright (c) 2026 REVYTECH, Inc.
#
# Applied on top of ARCH=x86_64 defconfig by scripts/build-linux-kernel.sh
# via scripts/config. Keep this file small and commented — do not dump a
# full .config here.
#
# Sections:
#   BOOT     — EFI stub, earlyprintk, serial (BIOS + UEFI guests)
#   VIRT     — virtio, hypervisors
#   FS       — squashfs, vfat, ext4 (ESP + live)
#   DESKTOP  — DRM / virtio-gpu / input for Plasma 6 Wayland (installed)
#   NET      — basic networking for builder/install

# --- BOOT (BIOS + UEFI) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y

# FreeBSD host build: avoid SELinux userspace host-tools that need Linux asm/types.h
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_SELINUX_BOOTPARAM=n
CONFIG_SECURITY_SELINUX_DEVELOP=n
CONFIG_SECURITY_SELINUX_AVC_STATS=n

# Avoid objtool/ORC (tools/ need Linux asm headers that FreeBSD host lacks)
CONFIG_UNWINDER_ORC=n
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_STACK_VALIDATION=n
CONFIG_OBJTOOL=n
CONFIG_FTRACE=n
CONFIG_KALLSYMS_ALL=n
# Without objtool, clang-built jump_label sites can be wrong and BUG in
# __jump_label_patch (seen under bhyve: unexpected op at security_capable).
CONFIG_JUMP_LABEL=n

# bhyve on AMD EPYC: hang inside alternative_instructions() after FPU init.
# CALL_THUNKS is selected by retpoline/rethunk mitigations — disable the set.
CONFIG_X86_KERNEL_IBT=n
CONFIG_CALL_THUNKS=n
CONFIG_MITIGATION_RETPOLINE=n
CONFIG_MITIGATION_RETHUNK=n
CONFIG_MITIGATION_UNRET_ENTRY=n
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=n
CONFIG_MITIGATION_RETBLEED=n
CONFIG_MITIGATION_SRSO=n
CONFIG_MITIGATION_IBPB_ENTRY=n
CONFIG_MITIGATION_IBRS_ENTRY=n

# Avoid certs/extract-cert (links OpenSSL; FreeBSD libcrypto vs linuxulator glibc)
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_SYSTEM_REVOCATION_LIST=n
CONFIG_IMA=n
CONFIG_INTEGRITY=n

# --- VIRT ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_ACPI=y

# VMware Workstation / Fusion / ESXi guests (operator tests in VMware VMs)
CONFIG_VMXNET3=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMWARE_BALLOON=y
CONFIG_VMWARE_VMCI=y
CONFIG_VMW_VMCI=y
CONFIG_DRM_VMWGFX=y
CONFIG_FUSE_FS=y

# --- FS ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# ZFS is out-of-tree (OpenZFS modules)

# --- DESKTOP (Plasma 6 / SDDM / KWin Wayland) ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# --- NET ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=y
