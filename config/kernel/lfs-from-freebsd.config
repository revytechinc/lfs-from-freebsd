# Kernel config fragment for lfs-from-freebsd
# Copyright (c) 2026 REVYTECH, Inc.
#
# Applied on top of ARCH=x86_64 defconfig by scripts/build-linux-kernel.sh
# via scripts/config. Keep this file small and commented — do not dump a
# full .config here.
#
# Sections:
#   BOOT     — EFI stub, earlyprintk, serial (BIOS + UEFI guests)
#   VIRT     — virtio, hypervisors
#   FS       — squashfs, vfat, ext4 (ESP + live)
#   DESKTOP  — DRM / virtio-gpu / input for Plasma 6 Wayland (installed)
#   NET      — basic networking for builder/install

# --- BOOT (BIOS + UEFI) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y

# --- VIRT ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_ACPI=y

# --- FS ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# ZFS is out-of-tree (OpenZFS modules)

# --- DESKTOP (Plasma 6 / SDDM / KWin Wayland) ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# --- NET ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=y
