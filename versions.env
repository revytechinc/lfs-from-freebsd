WAYLAND_PROTOCOLS_URL=https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/${WAYLAND_PROTOCOLS_VERSION}/downloads/${WAYLAND_PROTOCOLS_TARBALL}
WAYLAND_PROTOCOLS_SHA256=2786b6b1b79965e313f2c289c12075b9ed700d41844810c51afda10ee329576b
LIBDRM_VERSION=2.4.124
LIBDRM_TARBALL=libdrm-${LIBDRM_VERSION}.tar.xz
LIBDRM_URL=https://dri.freedesktop.org/libdrm/${LIBDRM_TARBALL}
LIBDRM_SHA256=ac36293f61ca4aafaf4b16a2a7afff312aa4f5c37c9fbd797de9e3c0863ca379
PIXMAN_VERSION=0.44.2
