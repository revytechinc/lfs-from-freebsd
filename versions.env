PIXMAN_SHA256=6349061ce1a338ab6952b92194d1b0377472244208d47ff25bef86fc71973466
# Chapter 1010 — xkb / fonts / evdev
LIBXKBCOMMON_VERSION=1.8.1
LIBXKBCOMMON_TARBALL=libxkbcommon-${LIBXKBCOMMON_VERSION}.tar.gz
LIBXKBCOMMON_URL=https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-${LIBXKBCOMMON_VERSION}.tar.gz
LIBXKBCOMMON_SHA256=c65c668810db305c4454ba26a10b6d84a96b5469719fe3c729e1c6542b8d0d87
