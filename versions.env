# Pinned versions for lfs-from-freebsd.
# Copyright (c) 2026 REVYTECH, Inc.
#
# Every URL and SHA256 here is the single source of truth for `make fetch`.
# When bumping a version: change the version, URL, and SHA256 together, then
# re-run `make fetch` on the CloudBSD build host (or any FreeBSD build host).
# Do not commit unverified SHA placeholders.

# Host claim
PROJECT_NAME=lfs-from-freebsd
TARGET_ARCH=x86_64
TARGET_TRIPLE=x86_64-linux-gnu

# LFS book (documentation / chapter map — not a build input itself)
LFS_BOOK_VERSION=12.3
LFS_BOOK_URL=https://www.linuxfromscratch.org/lfs/downloads/12.3/LFS-BOOK-12.3-NOCHUNKS.html
LFS_WGET_LIST_URL=https://www.linuxfromscratch.org/lfs/downloads/12.3/wget-list
LFS_MD5SUMS_URL=https://www.linuxfromscratch.org/lfs/downloads/12.3/md5sums

# Linux kernel (6.12 LTS; must stay inside OpenZFS supported window)
LINUX_VERSION=6.12.21
LINUX_TARBALL=linux-${LINUX_VERSION}.tar.xz
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/${LINUX_TARBALL}
LINUX_SHA256=9d1ae39a2ea024d99646f645fdbbbfa4545577132ba2643e01df75e32246d6c7

# BusyBox (source build preferred; static binary is Phase-1 bootstrap only)
BUSYBOX_VERSION=1.36.1
BUSYBOX_TARBALL=busybox-${BUSYBOX_VERSION}.tar.bz2
BUSYBOX_URL=https://busybox.net/downloads/${BUSYBOX_TARBALL}
BUSYBOX_SHA256=b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314
# Prebuilt static musl BusyBox (used when FreeBSD cross-build is not ready yet)
BUSYBOX_STATIC_URL=https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox
BUSYBOX_STATIC_SHA256=6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348

# OpenZFS for Linux (modules + userspace); CDDL — see LICENSES/CDDL-1.0.txt
OPENZFS_VERSION=2.3.2
OPENZFS_TARBALL=zfs-${OPENZFS_VERSION}.tar.gz
OPENZFS_URL=https://github.com/openzfs/zfs/releases/download/zfs-${OPENZFS_VERSION}/${OPENZFS_TARBALL}
OPENZFS_SHA256=80da628a9543ec3355bf410617450e167706948ceb287541455a1b8d87b8758a

# Limine bootloader (UEFI + BIOS hybrid ISO; avoids GRUB-on-ZFS feature fights)
LIMINE_VERSION=8.0.14
LIMINE_TARBALL=limine-${LIMINE_VERSION}.tar.xz
LIMINE_URL=https://github.com/limine-bootloader/limine/releases/download/v${LIMINE_VERSION}/${LIMINE_TARBALL}
LIMINE_SHA256=9422af86014a1414cac618375ed1e1be6b6f6d9b2217b46ce39f0a5b7ec5e7eb

# musl (optional static libc for BusyBox cross on FreeBSD)
MUSL_VERSION=1.2.5
MUSL_TARBALL=musl-${MUSL_VERSION}.tar.gz
MUSL_URL=https://musl.libc.org/releases/${MUSL_TARBALL}
MUSL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4

# ZFS pool layout (installed system — keep in sync with install-to-zfs.sh)
ZFS_POOL=rpool
ZFS_ROOT_DATASET=rpool/ROOT/lfs
ZFS_HOME_DATASET=rpool/home

# Builder guest (LFS chapters that assume a Linux host)
BUILDER_DISTRO=alpine
BUILDER_ALPINE_VERSION=3.21.3
BUILDER_ALPINE_ISO=alpine-virt-3.21.3-x86_64.iso
BUILDER_ALPINE_URL=https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/x86_64/alpine-virt-3.21.3-x86_64.iso
BUILDER_ALPINE_SHA256=f28171c35bbf623aa3cbaec4b8b29297f13095b892c1a283b15970f7eb490f2d
BUILDER_DISK_GB=40
BUILDER_MEM_MB=8192
BUILDER_CPUS=4

# ---------------------------------------------------------------------------
# Milestone C — installed desktop (BLFS-style). Live ISO does NOT include this.
# Pins are filled as chapters are implemented; empty SHA means "do not fetch yet".
# See docs/DESKTOP-PLASMA6.md
# ---------------------------------------------------------------------------
DESKTOP_ENABLED=1
DESKTOP_SESSION=plasmawayland
SDDM_VERSION=0.21.0
SDDM_TARBALL=sddm-${SDDM_VERSION}.tar.gz
SDDM_URL=https://github.com/sddm/sddm/archive/refs/tags/v${SDDM_VERSION}.tar.gz
SDDM_SHA256=
QT6_VERSION=6.8.2
PLASMA6_VERSION=6.3.2
KF6_VERSION=6.11.0
# Meta: chapter scripts expand these into full source lists under vendor/desktop/

# Build host note (documentation only; scripts detect uname)
# Operators: see docs/BUILD-HOST.md for the fleet machine used in practice.
RECOMMENDED_BUILD_HOST=freebsd-current-amd64
